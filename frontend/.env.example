# Deepraj Mail Pro — Frontend Environment Variables
#
# Copy this file to frontend/.env and fill in your values.
#   $ cp frontend/.env.example frontend/.env
#
# ── LOCAL DEVELOPMENT ────────────────────────────────────────────────────────
# Points to your local backend server.
REACT_APP_BACKEND_URL=http://localhost:3001

# ── PRODUCTION (Vercel) ───────────────────────────────────────────────────────
# Set this in your Vercel project → Settings → Environment Variables.
# Use your Render backend URL (no trailing slash).
# Example: https://deepraj-mail-pro.onrender.com
# REACT_APP_BACKEND_URL=https://your-backend.onrender.com
