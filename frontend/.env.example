# ─────────────────────────────────────────────────────────────────────────────
# Deepraj Mail Pro — Frontend Environment Variables
#
# Copy this file to `.env` in the frontend/ directory for local development.
# For Vercel deployment, add these in the Vercel Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── CRITICAL FOR SPLIT DEPLOYMENT (Vercel frontend + Render backend) ─────────
#
# Set this to your Render backend URL. Without this, ALL API calls go to the
# Vercel frontend domain (window.location.origin) instead of Render — causing
# every request to fail with 404.
#
# Example: https://deepraj-mail-pro-backend.onrender.com
REACT_APP_BACKEND_URL=https://your-backend-name.onrender.com

# ── LOCAL DEVELOPMENT ─────────────────────────────────────────────────────────
# For local dev, the proxy in package.json (http://localhost:3001) handles API routing.
# You can leave REACT_APP_BACKEND_URL unset or set it to http://localhost:3001.
