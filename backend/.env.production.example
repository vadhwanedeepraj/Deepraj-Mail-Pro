# ─────────────────────────────────────────────────────────────────────────────
# Deepraj Mail Pro — Backend PRODUCTION Environment Variables
#
# Usage:
#   Copy this file and fill in all values:
#   $ cp backend/.env.production.example .env.prod
#   $ nano .env.prod
#
# For Docker production:
#   docker-compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# For Render:
#   Set each variable in the Render dashboard under Environment Variables.
#   Do NOT upload this file to Render — set vars manually or via render.yaml.
#
# ⚠️  NEVER commit this file. It is already listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Recommended free providers:
#   Neon.tech  → https://neon.tech        (5 GB, serverless, always-on)
#   Supabase   → https://supabase.com     (500 MB, always-on)
#   Render DB  → Render dashboard add-on  (90-day free, then $7/mo)
DATABASE_URL=postgresql://user:password@host:5432/email_dispatcher?sslmode=require

# JWT signing secret
# Generate: openssl rand -hex 32   (must be at least 64 chars)
JWT_SECRET=

# AES-256-GCM encryption key
# Generate: openssl rand -hex 16   (must be at least 32 chars)
# ⚠️  CRITICAL: Set ONCE. NEVER change after first deploy.
#              Changing corrupts ALL stored SMTP credentials.
ENCRYPTION_KEY=

# Default admin account (used for initial seed on first startup)
# Use a strong password — minimum 12 chars required in production.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=

# ── REQUIRED FOR PRODUCTION ───────────────────────────────────────────────────

PORT=10000
NODE_ENV=production

# Your deployed Render backend URL (no trailing slash)
# Example: https://deepraj-mail-pro.onrender.com
BACKEND_URL=

# Your deployed Vercel frontend URL (no trailing slash)
# Example: https://deepraj-mail-pro.vercel.app
CORS_ORIGINS=

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# Log verbosity — use "warn" in production to reduce noise
LOG_LEVEL=warn

# Redis (optional — in-memory fallback is used when not set)
# Recommended: Render Redis add-on or Upstash (free tier available)
# REDIS_URL=redis://...

# ── VERCEL SMTP PROXY ────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# Must match the PROXY_SECRET set in your Vercel project env vars.
PROXY_SECRET=

VERCEL_PROXY_URL=https://email-proxy-one.vercel.app/api/send

# MUST be false in production — Render blocks outbound SMTP ports
BYPASS_PROXY_LOCALLY=false

# ── DOCKER-ONLY (only needed for docker-compose.prod.yml) ────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=email_dispatcher
REDIS_PASSWORD=
