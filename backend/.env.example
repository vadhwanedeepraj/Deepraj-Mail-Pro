# ─────────────────────────────────────────────────────────────────────────────
# Deepraj Mail Pro — Backend Environment Variables
#
# Copy this file to `.env` in the backend/ directory for local development.
# NEVER commit the actual .env file — it is already in .gitignore.
#
# For Render production deployment, set these in the Render dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (from Render database add-on or local Docker)
DATABASE_URL=postgresql://postgres:password@localhost:5432/email_dispatcher

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=your-64-character-random-string-here

# AES-256-GCM encryption key for SMTP passwords
# ⚠️  CRITICAL: Set ONCE and NEVER change. Changing this permanently corrupts
#    all stored SMTP credentials in the database.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-32-character-key-here-changeme

# Default admin account (created automatically on first startup)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=SecureAdminPassword123

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# Server port (Render overrides this automatically in production)
PORT=3001

# Node environment
NODE_ENV=development

# Public URL of the backend server (used for tracking pixel and unsubscribe links)
BACKEND_URL=http://localhost:3001

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info

# Redis connection (optional — falls back to in-memory queue if not set)
# REDIS_URL=redis://localhost:6379

# ── VERCEL PROXY ─────────────────────────────────────────────────────────────

# Shared secret between backend and Vercel proxy (prevents open relay abuse)
# Must match PROXY_SECRET set in your Vercel project environment variables.
# Generate with: openssl rand -hex 32
PROXY_SECRET=your-proxy-shared-secret-here

# URL of the Vercel SMTP proxy function
# If using your own Vercel deployment, set to your /api/send endpoint
VERCEL_PROXY_URL=https://email-proxy-one.vercel.app/api/send

# Set to "true" to bypass the Vercel proxy and use direct SMTP (local dev only)
# Note: Render free tier blocks SMTP ports — always use proxy in production
BYPASS_PROXY_LOCALLY=true
