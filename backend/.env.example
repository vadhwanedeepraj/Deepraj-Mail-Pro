# ─────────────────────────────────────────────────────────────────────────────
# Deepraj Mail Pro — Backend Environment Variables
#
# LOCAL DEVELOPMENT:
#   Copy this file to backend/.env and fill in your values.
#   $ cp backend/.env.example backend/.env
#
# PRODUCTION (Render / Docker):
#   See backend/.env.production.example
#   Set these values in the Render dashboard or as Docker env vars.
#
# ⚠️  NEVER commit your actual .env file to version control!
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Local Docker: postgresql://postgres:password@localhost:5432/email_dispatcher
# Render DB:    from Render dashboard → your DB → "External Connection String"
# Neon.tech:    from Neon dashboard → connection string (free, serverless)
DATABASE_URL=postgresql://postgres:password@localhost:5432/email_dispatcher

# JWT signing secret — used to sign and verify auth tokens
# Generate: openssl rand -hex 32   (produces 64 hex chars — minimum required)
# ⚠️  Changing this invalidates ALL active user sessions immediately.
JWT_SECRET=your-64-character-random-string-here-replace-before-running

# AES-256-GCM encryption key for stored SMTP passwords
# Generate: openssl rand -hex 16   (produces 32 hex chars — minimum required)
# ⚠️  CRITICAL: Set ONCE and NEVER change.
#              Changing this permanently corrupts ALL stored SMTP credentials.
ENCRYPTION_KEY=your-32-character-key-here-changeme-now

# Default admin account (created automatically on first startup)
# The admin will NOT be forced to reset their password on first login.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=YourSecurePassword123

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# Server port (Render injects this automatically in production)
PORT=3001

# Node environment: development | production | test
NODE_ENV=development

# Public backend URL (used in tracking pixel & unsubscribe links in emails)
BACKEND_URL=http://localhost:3001

# Allowed CORS origins (comma-separated, no trailing slashes)
CORS_ORIGINS=http://localhost:3000

# Log verbosity: error | warn | info | debug
LOG_LEVEL=debug

# ── REDIS (optional — in-memory fallback used when not set) ──────────────────
# Leave blank for development without Redis (uses local in-memory queue).
# REDIS_URL=redis://localhost:6379

# ── VERCEL SMTP PROXY ────────────────────────────────────────────────────────
# Shared secret between backend and Vercel proxy (prevents open relay abuse)
# Generate: openssl rand -hex 32
# Must match PROXY_SECRET in your Vercel project env vars.
PROXY_SECRET=your-proxy-shared-secret-here

# URL of the Vercel SMTP proxy serverless function
VERCEL_PROXY_URL=https://email-proxy-one.vercel.app/api/send

# Set to "true" to bypass the Vercel proxy and use DIRECT SMTP locally.
# Render free tier blocks SMTP ports — always set to "false" in production.
BYPASS_PROXY_LOCALLY=true

# ── DIRECT SMTP (optional — only used when BYPASS_PROXY_LOCALLY=true) ─────────
# Leave blank to use Gmail (default). Set SMTP_HOST to use any other provider.
# Examples:
#   Outlook/Hotmail : SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SECURE=false
#   Yahoo           : SMTP_HOST=smtp.mail.yahoo.com  SMTP_PORT=587  SMTP_SECURE=false
#   Custom/cPanel   : SMTP_HOST=mail.yourdomain.com  SMTP_PORT=465  SMTP_SECURE=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
