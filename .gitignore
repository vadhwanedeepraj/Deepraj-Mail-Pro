# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.npm

# ── Environment Variables ──────────────────────────────────────────────────────
# Never commit actual secrets — only commit .example templates
.env
.env.local
.env.production
.env.*.local
.env.prod
backend/.env
backend/.env.prod
frontend/.env
# Example templates ARE committed (no secrets, just documentation)
!backend/.env.example
!backend/.env.production.example
!frontend/.env.example

# ── Build Output ──────────────────────────────────────────────────────────────
build/
dist/
frontend/build/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
backend/logs/
*.log
npm-debug.log*

# ── Runtime Data ──────────────────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock

# ── OS Files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Uploaded Attachments (runtime, not source) ────────────────────────────────
backend/attachments/

# ── Legacy JSON data files (replaced by PostgreSQL) ───────────────────────────
backend/users.json
backend/campaigns.json
backend/tracking.json
backend/scheduled.json
backend/unsubscribes.json

# ── Package locks — commit workspace-specific locks for reproducible CI builds ─
# Root-level lock is excluded (workspaces each have their own)
/package-lock.json
